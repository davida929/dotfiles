# function wrapper
function y
	set tmp (mktemp -t "yazi-cwd.XXXXXX")
	command yazi $argv --cwd-file="$tmp"
	if read -z cwd < "$tmp"; and [ "$cwd" != "$PWD" ]; and test -d "$cwd"
		builtin cd -- "$cwd"
	end
	command rm -f -- "$tmp"
end
source "$HOME/.cargo/env.fish"
alias ls="eza --icons"
alias v="nvim"
alias t="tmux"
zoxide init --cmd cd fish | source

